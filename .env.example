# =============================================================================
# Arab Computers — Client Management. Copy to .env for local development.
# On Vercel, set these in Project → Settings → Environment Variables.
# =============================================================================

# --- Database (Neon via Vercel Marketplace sets both automatically) ----------
# Pooled connection used by the app at runtime
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Direct (unpooled) connection used by `prisma migrate`
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# --- Auth.js -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# --- App ---------------------------------------------------------------------
# Public base URL (used in emails and links). On Vercel: https://<your-domain>
APP_URL="http://localhost:3000"

# --- Cron --------------------------------------------------------------------
# Vercel sends "Authorization: Bearer $CRON_SECRET" to /api/cron/daily.
# Generate with: openssl rand -hex 24
CRON_SECRET=""

# --- File storage (Vercel Blob; set automatically when you connect a store) --
BLOB_READ_WRITE_TOKEN=""

# --- Email -------------------------------------------------------------------
# Provider is chosen in Settings → Email (RESEND or SMTP). Credentials live here.
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# --- Seed --------------------------------------------------------------------
# Password for admin@arab-computers.com created by `npm run db:seed`
SEED_ADMIN_PASSWORD=""
